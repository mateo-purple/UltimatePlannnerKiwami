rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No user can read or edit another account's schedule.
    match /users/{userId}/entries/{entryId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'syncId','title','note','category','source','fixed','weekly',
          'startMs','endMs','deadlineMs','estimateMin','progress',
          'difficulty','createdMs','updatedMs','deleted'
        ])
        && request.resource.data.syncId == entryId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 10000
        && request.resource.data.updatedMs is int
        && request.resource.data.deleted is bool;
    }
  }
}